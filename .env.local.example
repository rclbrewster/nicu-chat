# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# Model overrides (optional; defaults shown)
CHAT_MODEL=gpt-4o-mini          # internal paraphrase + rerank steps
ANSWER_MODEL=gpt-4o             # user-facing answer (copies doses verbatim)
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o             # OCR / document transcription

# ---- Supabase ----
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Settings -> API -> service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used by the ingest / test-retrieval scripts (same project as above)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PRIVATE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Auth (passwordless email code, gated by a shared access code) ----
# Anyone who enters this code can register with ANY email address — it is
# not tied to an institutional domain. Server-side only. Pick something
# long/random, share it out of band, rotate it if it leaks.
ACCESS_CODE=change-me-to-a-real-passphrase

# Base URL for the magic-link redirect. Must match a Supabase "Redirect URL".
NEXT_PUBLIC_SITE_URL=http://localhost:3000
