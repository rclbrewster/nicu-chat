# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# Model overrides (optional; defaults shown)
CHAT_MODEL=gpt-4o-mini          # internal paraphrase + rerank steps
ANSWER_MODEL=gpt-4o             # user-facing answer (copies doses verbatim)
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o             # OCR / document transcription

# ---- Supabase (knowledge base + feedback storage only — no Supabase Auth) ----
# Server-only. Settings -> API -> service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used by the app, and by the ingest / test-retrieval scripts.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PRIVATE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Auth: single shared access code, no per-user identity ----
# Whoever has this code gets in — full stop. Not tied to an email, a
# domain, or an institution. Pick something long/random, share it out of
# band (not over email), rotate it (and tell everyone) if it leaks.
# A session, once granted, is remembered in the browser for ~180 days.
ACCESS_CODE=change-me-to-a-real-passphrase

# Optional: separate secret used to sign the session cookie. Falls back to
# ACCESS_CODE if unset, which is fine for a pilot — set this explicitly if
# you want rotating ACCESS_CODE to NOT also invalidate existing sessions.
# SESSION_SECRET=

# ---- "Request access code" popup ----
# Requests are always saved to the access_requests table. Set RESEND_API_KEY
# too if you also want them emailed (https://resend.com -- no SDK needed,
# the app calls its HTTP API directly). Without a verified sending domain,
# Resend only delivers to the account's own verified email address, so
# ACCESS_REQUEST_TO should match that until a domain is verified.
RESEND_API_KEY=
ACCESS_REQUEST_FROM=NICU Wayfinder <onboarding@resend.dev>
ACCESS_REQUEST_TO=rbrewster@stanford.edu
